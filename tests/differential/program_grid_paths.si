\\ Counts up/left lattice paths on a 5x5 grid with obstacles, by recursion.
\\ Cells are flattened: index = row * 5 + col. Row 0 and column 0 are walls,
\\ so the start (1,1), index 6, is the only base case, and recursion from an
\\ open cell stays inside the grid.
r .f64 [ !25 ] .blocked
!1 j.blocked !0 + :
!1 j.blocked !1 + :
!1 j.blocked !2 + :
!1 j.blocked !3 + :
!1 j.blocked !4 + :
!1 j.blocked !5 + :
!1 j.blocked !10 + :
!1 j.blocked !15 + :
!1 j.blocked !20 + :
!1 j.blocked !12 + :
!1 j.blocked !17 + :
{.paths
  @ j.blocked # + y
  { $ !0 ; @ !6 = { $ !1 ; @ !5 - (.paths) # !1 - (.paths) + } }
}
!24 (.paths) |
!19 (.paths) |
!13 (.paths) |
!6 (.paths) |
